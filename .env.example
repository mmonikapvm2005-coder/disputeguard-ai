# ==========================================
# DisputeGuard AI — Configuration
# ==========================================

# 1. PayPal Developer Credentials (Optional)
# If left blank, DisputeGuard AI runs in high-fidelity Simulator Mode
# using official PayPal Disputes API schemas.
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
PAYPAL_ENV=sandbox

# 2. AI Reasoning API Key (Optional)
# The built-in deterministic forensic rules engine handles all claims
# out-of-the-box. Add an external LLM key if desired.
GEMINI_API_KEY=
OPENAI_API_KEY=
